pnpm --filter @shibui-ui/ui type-check

# Si cambió algún componente, regenerar el manifiesto y los datos de la API
# desde la fuente de verdad (el código) y dejarlos en el mismo commit.
if git diff --cached --name-only | grep -qE 'packages/shibui-ui/src/(components/.*\.(component|types)\.ts|types/.*\.ts)$'; then
  echo "↻ Componentes cambiados → regenerando manifiesto + datos de API"
  pnpm --filter @shibui-ui/ui analyze
  pnpm --filter @shibui-ui/ui generate:components-api
  git add apps/shibui-api/src/domain/components/data/components.generated.ts
fi

cd packages/shibui-ui && pnpm exec lint-staged && pnpm exec stylelint --config .config/.stylelintrc.json --fix "src/**/*.css"