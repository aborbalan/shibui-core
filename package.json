{
  "name": "shibui-ecosystem",
  "private": true,
  "description": "Monorepo para testing de componentes Shibui UI",
  "repository": {
    "type": "git",
    "url": "https://github.com/aborbalan/shibui-core.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "start:react": "pnpm --filter app-react dev",
    "start:svelte": "pnpm --filter app-svelte dev",
    "start:angular": "pnpm --filter app-angular start",
    "start:cv": "pnpm --filter app-cv start",
    "start:torii": "pnpm --filter app-torii dev",
    "start:api": "pnpm --filter @shibui-ui/api start:dev",
    "start:tauri": "pnpm --filter @shibui/app-tauri tauri dev",
    "dev:all": "concurrently -n \"REACT,SVELTE,ANGULAR\" -c \"cyan,magenta,blue\" \"pnpm start:react\" \"pnpm start:svelte\" \"pnpm start:angular\"",
    "build:shibui": "pnpm --filter @shibui-ui/ui build",
    "build:api": "pnpm --filter @shibui-ui/api build",
    "build:react": "pnpm --filter app-react build",
    "build:cv": "pnpm --filter app-cv build",
    "build:torii": "pnpm --filter app-torii build",
    "prepare": "husky",
    "kura": "tsx packages/kura/src/cli.ts",
    "type-check": "pnpm exec tsc --noEmit --project packages/shibui-ui/tsconfig.json",
    "storybook": "pnpm --filter @shibui-ui/ui storybook",
    "build-storybook": "pnpm --filter @shibui-ui/ui build-storybook",
    "lint": "pnpm --filter @shibui-ui/ui lint",
    "test:consumers": "pnpm build:shibui && pnpm --filter @shibui/consumer-tests test",
    "test:consumers:react": "pnpm --filter @shibui/consumer-tests test:react",
    "test:consumers:svelte": "pnpm --filter @shibui/consumer-tests test:svelte",
    "test:consumers:angular": "pnpm --filter @shibui/consumer-tests test:angular",
    "worker:cf:deploy": "pnpm --filter @shibui-api/cf-cache-worker cf:deploy",
    "worker:cf:dev": "pnpm --filter @shibui-api/cf-cache-worker dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@pwrs/cem": "^0.11.0",
    "@types/node": "^25.3.5",
    "concurrently": "^9.2.1",
    "firebase-tools": "^15.27.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "semantic-release": "^24.2.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0"
  },
  "pnpm": {
    "overrides": {
      "@playwright/test": ">=1.55.1",
      "jsonpath-plus": ">=10.2.0",
      "fast-uri": ">=3.1.5 <4",
      "minimatch": ">=9.0.7",
      "path-to-regexp": ">=8.0.0",
      "undici": ">=7.29.0 <8",
      "ws": ">=8.21.0",
      "esbuild": "0.25.12",
      "ip-address": ">=10.3.1 <11",
      "shell-quote": ">=1.8.4",
      "hono": ">=4.12.34 <5",
      "multer": ">=2.2.0",
      "piscina": ">=5.2.0",
      "tmp": ">=0.2.6",
      "form-data": ">=4.0.6",
      "sigstore": ">=4.1.1 <5",
      "@sigstore/core": ">=3.2.1 <4",
      "@sigstore/verify": ">=3.1.1 <4",
      "morgan": ">=1.11.0",
      "qs": ">=6.15.2",
      "tar": ">=7.5.21 <8",
      "uuid": ">=11.1.1 <12",
      "@babel/core": ">=7.29.6 <8",
      "js-yaml@3": ">=3.15.1 <4",
      "js-yaml@4": ">=4.3.1 <5",
      "brace-expansion": ">=5.0.9 <6",
      "@grpc/grpc-js": ">=1.14.4 <2",
      "protobufjs": ">=7.6.3 <8",
      "immutable": ">=5.1.8 <6",
      "@opentelemetry/core": ">=2.8.0 <3",
      "nanoid@3": ">=3.3.18 <4",
      "nanoid@5": ">=5.1.16 <6",
      "body-parser@1": ">=1.20.6 <2",
      "body-parser@2": ">=2.3.0 <3",
      "@hono/node-server@1": ">=1.19.15 <2",
      "basic-ftp": ">=5.3.1 <6",
      "re2": ">=1.26.1 <2",
      "postcss": ">=8.5.23 <9",
      "vitest": ">=4.1.8 <5",
      "@vitest/browser": ">=4.1.8 <5",
      "@vitest/browser-playwright": ">=4.1.8 <5",
      "@vitest/coverage-v8": ">=4.1.8 <5",
      "@vitest/ui": ">=4.1.8 <5"
    }
  }
}