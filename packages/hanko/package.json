{
  "name": "@shibui-ui/hanko",
  "version": "0.1.0",
  "description": "判子 — motor de verificación de confianza (trust) manifest-driven para Web Components.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "web-components",
    "custom-elements",
    "custom-elements-manifest",
    "cem",
    "accessibility",
    "a11y",
    "trust",
    "verification",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aborbalan/shibui-core.git",
    "directory": "packages/hanko"
  },
  "bugs": "https://github.com/aborbalan/shibui-core/issues",
  "homepage": "https://github.com/aborbalan/shibui-core/tree/main/packages/hanko#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "smoke": "tsx src/smoke/run.ts",
    "observe": "tsx dogfood/probe-shibui.ts",
    "report": "tsx src/report/run.ts",
    "assets:page": "tsx dogfood/bundle-shibui-page.ts",
    "report:full": "pnpm run observe && pnpm run report && pnpm run assets:page",
    "report:page": "pnpm run report && pnpm run assets:page",
    "gate": "tsx src/report/gate-run.ts dogfood/baseline.json",
    "gate:floor": "tsx src/report/gate-run.ts dogfood/baseline.floor.json",
    "baseline:write": "tsx src/report/gate-run.ts dogfood/baseline.json hanko-report/trust-report.json --write",
    "baseline:write:floor": "tsx src/report/gate-run.ts dogfood/baseline.floor.json hanko-report/trust-report.json --write",
    "issues": "tsx src/report/issues-run.ts",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.4",
    "axe-core": "^4.10.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
