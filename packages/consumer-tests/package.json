    "test:ui": "playwright test --ui",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@shibui-ui/ui": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svelte": "^5.55.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
