{
  "name": "@shibui/consumer-tests",
  "private": true,
  "version": "0.0.1",
  "description": "Consumer contract tests — verifica el contrato de integración de @shibui-ui/ui con React 19, Svelte 5 y Angular 21",
  "scripts": {
    "test": "playwright test",
    "test:react": "playwright test tests/react.spec.ts",
    "test:svelte": "playwright test tests/svelte.spec.ts",
