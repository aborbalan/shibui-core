{
  "compilerOptions": {
    "target": "ESNext",
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "jsx": "react-jsx",
    "emitDeclarationOnly": false,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@shibui-ui/ui/react": ["../../packages/shibui-ui/dist/react/index.ts"],
      "@shibui-ui/ui": ["../../packages/shibui-ui/dist/index.d.ts"]
    }
  },
  "include": ["src", "src/custom-elements.d.ts", "src/vite-env.d.ts"],
  "exclude": ["node_modules", "dist"]
}
